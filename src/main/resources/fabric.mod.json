{
  "schemaVersion": 1,
  "id": "kaleidoscope_cookery",
  "version": "${version}",
  "name": "Kaleidoscope Cookery",
  "description": "Cook all kinds of delicious food!",
  "authors": ["ysbb", "tartaric_acid", "NightEpiphany"],
  "contact": {},
  "license": "BSD-3-Clause + CC BY-NC-SA 4.0",
  "icon": "assets/kaleidoscope_cookery/cover.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.github.ysbbbbbb.kaleidoscopecookery.KaleidoscopeCookery"],
    "client": ["com.github.ysbbbbbb.kaleidoscopecookery.KaleidoscopeCookeryClient"],
    "jei_mod_plugin": [
      "com.github.ysbbbbbb.kaleidoscopecookery.compat.jei.ModJeiPlugin"
    ],
    "rei_client": [
      "com.github.ysbbbbbb.kaleidoscopecookery.compat.rei.ModREIClientPlugin"
    ],
    "jade": [
      "com.github.ysbbbbbb.kaleidoscopecookery.compat.jade.ModPlugin",
      "com.github.ysbbbbbb.kaleidoscopecookery.compat.jade.ModClientPlugin"
    ]
  },
  "mixins": [
    "kaleidoscope_cookery.mixins.json",
    {
      "config": "kaleidoscope_cookery.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "kaleidoscope_cookery.accesswidener",
  "depends": {
    "java": ">=25",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "~${minecraft_version}"
  },
  "suggests": {
    "jei": "*",
    "jade": "*",
    "wthit": ">=20.0.0",
    "roughlyenoughitems": "*",
    "foodeffecttooltips": "*",
    "farmersdelight": "*",
    "carryon": ">=2.9.1",
    "diggusmaximus": ">=1.5.9-beta.1"
  }
}
